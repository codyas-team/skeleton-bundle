{# @var \Codyas\SkeletonBundle\Model\CrudEntity entityConfig #}
{% extends entityConfig.baseLayout %}
{% set fqdn = entityConfig.encodedFqdn %}
{% block title %}{{ entityConfig.headerTranslatableLabel | trans({"%count%":2}) }} | {{ csk_option('templating.name') }}{% endblock %}
{% block page_title %}{{ entityConfig.headerTranslatableLabel | trans({"%count%":2}) }}{% endblock %}

{% block page_subtitle %}
    <div class="text-body-secondary mt-1">
        {{ "%itemsPerPage% of %total% records" | trans({"%itemsPerPage%":(items | length), "%total%": pagination.totalItemCount}, 'SkeletonBundle') }}
    </div>
{% endblock %}

{% block breadcrumb %}
    {% include '@Skeleton/crud/layout/tabler/_breadcrumbs.html.twig' %}
{% endblock %}

{% block page_actions %}
    <div class="btn-list">
        {% if entityConfig.isExportable %}
            <div class="dropdown">
                <button class="btn dropdown-toggle align-text-top" data-bs-toggle="dropdown">{{ "Export" | trans({}, 'SkeletonBundle') }}</button>
                <div class="dropdown-menu dropdown-menu-end">
                    {% for exportDefinition in entityConfig.exportConfiguration %}
                        <a href="{{ path('csk_crud_export', {'fqdn': fqdn, 'format': exportDefinition.format}) }}?{{ app.request.queryString }}"
                           class="dropdown-item"
                           target="_blank"
                        >
                            <i class="{{ exportDefinition.icon }} me-1"></i>
                            {{ exportDefinition.label | trans({"%count%":1}) }}
                        </a>
                    {% endfor %}
                </div>
            </div>

        {% endif %}
        {% if csk_is_authorized(constant('Codyas\\SkeletonBundle\\Model\\CrudEntityInterface::CREATE'), entityConfig) %}
            <a href="{{ path(entityConfig.createRoute, {'fqdn': entityConfig.customCreateRoute ? null : fqdn}) }}"
               class="btn btn-primary d-none d-sm-inline-block">
                <i class="fa fa-plus"></i>
                {{ entityConfig.createTranslatableLabel | trans({"%count%":1}) }}
            </a>
        {% endif %}
    </div>
{% endblock %}

{% block body_start %}
    data-controller="csk-crud csk-notify"
    data-csk-crud-generic-delete-msg-value="{{ 'Something went wrong while deleting the record. Please try again later.' | trans({}, 'SkeletonBundle') }}"
    data-csk-notify-alerts-value="{{ app.flashes('csk-non-blocking-alerts') | json_encode }}"
    data-action="csk-crud-table-record:deleteRecord@window->csk-crud#showDeleteDialog"
{% endblock %}

{% block page_content %}
    <div class="row">
        {% if entityConfig.filterable %}
            <div class="col-3">
                {{ form_start(filterForm, {attr: {
                    'data-controller': 'csk-crud-filter',
                    'data-action': 'reset->csk-crud-filter#reset'
                }}) }}
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fa fa-filter"></i>
                            {{ "Filter" | trans({}, 'SkeletonBundle') }}</h3>
                    </div>
                    <div class="card-body">
                        {% include entityConfig.filterTemplate %}
                    </div>
                    <div class="card-footer">
                        <div class="row justify-content-center">
                            <div class="col-10 d-flex gap-2">
                                <a class="btn btn-default" href="{{ path(entityConfig.listRoute) }}">{{ "Clear" | trans({}, 'SkeletonBundle') }}</a>
                                <button type="submit" class="btn w-100 btn-primary">
                                    {{ "Apply" | trans({}, 'SkeletonBundle') }}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                {{ form_end(filterForm) }}
            </div>
        {% endif %}
        <div class="col-{{ entityConfig.filterable ? '9' : '12' }}">
            <div class="card">
                <div class="card-body p-0 {{ entityConfig.dataTableResponsive ? 'table-responsive' : '' }}">
                    {% if items|length > 0 %}
                        {% include '@Skeleton/crud/layout/tabler/_data_table.html.twig' %}
                    {% else %}
                        <div class="p-5 text-center text-muted">
                            <h3 class="fw-normal">
                                <i class="fa fa-inbox d-block fa-5x mb-3"></i>
                                {{ "There are no results to display." | trans({}, 'SkeletonBundle') }}
                            </h3>
                        </div>
                    {% endif %}
                </div>
                {% if pagination.pageCount > 1 %}
                    <div class="card-footer">
                        <div class="d-flex justify-content-end">
                            {{ knp_pagination_render(pagination) }}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

{% block page_content_after %}
    <div class="modal modal-blur fade" id="deleteDialog" tabindex="-1" data-csk-crud-target="deleteDialog">
        <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
            <div class="modal-content">
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        aria-label="{{ "Close" | trans({}, 'SkeletonBundle') }}"></button>
                <div class="modal-status bg-danger"></div>
                <div class="modal-body text-center py-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon mb-2 text-danger icon-lg" width="24" height="24"
                         viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round"
                         stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M12 9v2m0 4v.01"/>
                        <path
                            d="M5 19h14a2 2 0 0 0 1.84 -2.75l-7.1 -12.25a2 2 0 0 0 -3.5 0l-7.1 12.25a2 2 0 0 0 1.75 2.75"/>
                    </svg>
                    <h3>{{ "Please confirm" | trans({}, 'SkeletonBundle') }}</h3>
                    <div class="text-secondary">
                        {{ "Do you really want to remove this item? This action cannot be undone." | trans({}, 'SkeletonBundle') }}
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="w-100">
                        <div class="row">
                            <div class="col">
                                <a href="#" class="btn w-100" data-bs-dismiss="modal">
                                    {{ "Cancel" | trans({}, 'SkeletonBundle') }}
                                </a>
                            </div>
                            <div class="col">
                                <button class="btn btn-danger w-100"
                                        data-action="csk-crud#deleteRecord"
                                        data-csk-crud-target="deleteDialogButton"
                                >
                                    {{ "Delete" | trans({}, 'SkeletonBundle') }}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% include '@Skeleton/crud/layout/tabler/_entity_dialogs.html.twig' %}
{% endblock %}