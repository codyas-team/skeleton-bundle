{# @var \Codyas\SkeletonBundle\Model\CrudEntity entityConfig #}
{% extends entityConfig.baseLayout %}
{% set pageTitle = instance.__toString %}
{% block breadcrumb %}
    {% include '@Skeleton/crud/layout/tabler/_breadcrumbs_form.html.twig' %}
{% endblock %}

{% block page_title %}{{ pageTitle }}{% endblock %}

{% block page_subtitle %}{% endblock %}

{% block page_actions %}
    {% if csk_is_authorized(constant('Codyas\\SkeletonBundle\\Model\\CrudEntityInterface::EDIT'), entityConfig, instance) %}
        <div class="btn-list">
            <a href="{{ path(entityConfig.editRoute, {'id': instance.id, 'fqdn': entityConfig.customEditRoute ? null : fqdn}) }}"
               class="btn btn-primary d-none d-sm-inline-block">
                <i class="fas fa-edit"></i>
                {{ "Edit" | trans({}, 'SkeletonBundle') }}
            </a>
        </div>
    {% endif %}
{% endblock %}

{% block page_content %}
    {% include entityConfig.instanceDetailsContentTemplate %}
{% endblock %}