{# @var \Codyas\SkeletonBundle\Model\CrudEntity entityConfig #}
{% set fqdn = entityConfig.encodedFqdn %}
<div class="card" data-controller="csk-partial-card">
    <div class="card-header bg-brand">
        <h5 class="card-title">
            {% if entityConfig.icon %}
                <i class="{{ entityConfig.icon }}"></i>
            {% endif %}
            {{ entityConfig.headerTranslatableLabel | trans({"%count%":2}) }}</h5>
        <div class="card-actions">
            {% if csk_is_authorized(constant('Codyas\\SkeletonBundle\\Model\\CrudEntityInterface::CREATE'), entityConfig) %}
                <button type="button" class="btn btn-sm rounded btn-primary"
                        data-action="click->csk-partial-card#requestDialog"
                        data-dialog-id="{{ entityConfig.dialogs[0].id }}"
                        data-load-url="{{ path(entityConfig.dialogs[0].loadUrl, {
                            'id': scope.id | default(""),
                            'scope': csk_get_encoded_class(scope)
                        })
                        }}"
                >
                    <i class="fa fa-plus me-1"></i>
                    {{ entityConfig.createTranslatableLabel | trans({"%count%":1}) }}
                </button>
            {% endif %}

        </div>
    </div>
    <div class="card-body p-0">
        <div
            class="csk-data-table"
            data-controller="csk-datatable csk-crud"
            data-csk-datatable-target="dialog"
            data-csk-datatable-csk-datatable-item-outlet=".data-table-item"
            data-csk-datatable-load-url-value="{{ url(entityConfig.listRoute, {'scope': scopeFqdn, 'id': scope ? scope.id : ""}) }}"
            data-csk-datatable-filter-url-value="{{ url(entityConfig.listRoute, {'scope': scopeFqdn, 'id': scope ? scope.id : ""}) }}"
            data-csk-datatable-csrf-token-value="{{ csrf_token(scope.id) }}"
            data-csk-datatable-confirm-title-value="{{ "Please confirm" | trans }}"
            data-csk-datatable-confirm-text-value="{{ "Do you really want to process the current page modifications?" | trans }}"
            data-csk-datatable-filter-value="all"
            data-csk-crud-generic-delete-msg-value="{{ 'Something went wrong while deleting the record. Please try again later.' | trans({}, 'SkeletonBundle') }}"
            data-csk-crud-crud-mode-value="{{ entityConfig.crudMode }}"
            data-action="csk-crud-dialog:dialog_processed@window->csk-datatable#loadContent csk-crud:record_deleted@window->csk-datatable#loadContent csk-crud-table-record:deleteRecord@window->csk-crud#showDeleteDialog"
        >
            <div class="filter p-3 text-right d-none">
