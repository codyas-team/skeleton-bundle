            </div>
            <div class="dialog-container">
                <div
                    data-csk-datatable-target="dialogBody"
                    class="dialog-body d-flex flex-column position-relative">
                    <div data-csk-datatable-target="content" class="dialog-content w-100"></div>
                    <div data-csk-datatable-target="placeholder"
                         class="dialog-placeholder text-center d-flex justify-content-center d-none">
                        <div>
                            <i class="fa fa-spinner-third fa-spin fa-4x mb-4"></i>
                            <h5 class="font-weight-light">{{ "Loading, please wait." | trans }}</h5>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="row justify-content-end">
                        <div class="col-lg-8">
                            <div data-csk-datatable-target="pagination" class="justify-content-end d-flex"></div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal modal-blur fade" id="{{ entityConfig.fqdn }}-deleteDialog" tabindex="-1" data-csk-crud-target="deleteDialog">
                <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <button type="button" class="btn-close" data-bs-dismiss="modal"
                                aria-label="{{ "Close" | trans({}, 'SkeletonBundle') }}"></button>
                        <div class="modal-status bg-danger"></div>
                        <div class="modal-body text-center py-4">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon mb-2 text-danger icon-lg" width="24" height="24"
                                 viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                <path d="M12 9v2m0 4v.01"/>
                                <path
                                    d="M5 19h14a2 2 0 0 0 1.84 -2.75l-7.1 -12.25a2 2 0 0 0 -3.5 0l-7.1 12.25a2 2 0 0 0 1.75 2.75"/>
                            </svg>
                            <h3>{{ "Please confirm" | trans({}, 'SkeletonBundle') }}</h3>
                            <div class="text-secondary">
                                {{ "Do you really want to remove this item? This action cannot be undone." | trans({}, 'SkeletonBundle') }}
                            </div>
                        </div>
                        <div class="modal-footer">
                            <div class="w-100">
                                <div class="row">
                                    <div class="col">
                                        <a href="#" class="btn w-100" data-bs-dismiss="modal">
                                            {{ "Cancel" | trans({}, 'SkeletonBundle') }}
                                        </a>
                                    </div>
                                    <div class="col">
                                        <button class="btn btn-danger w-100"
                                                data-action="csk-crud#deleteRecord"
                                                data-csk-crud-target="deleteDialogButton"
                                        >
                                            {{ "Delete" | trans({}, 'SkeletonBundle') }}
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% include '@Skeleton/crud/layout/tabler/_entity_dialogs.html.twig' with {
        dialog: entityConfig.dialogs[0]
    } %}
</div>