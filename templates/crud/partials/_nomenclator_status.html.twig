{% if instance.deletedAt %}
    <span class="badge bg-danger me-1"
          title="{{ "This record is closed. You cannot assign it to other resources." | trans({}, 'SkeletonBundle') }}"></span>
    {{ "Closed" | trans({}, 'SkeletonBundle') }}
{% else %}
    <span class="badge bg-success me-1"
          title="{{ "The record is open, you can assign it to any other resource." | trans({}, 'SkeletonBundle') }}"></span>
    {{ "Open" | trans({}, 'SkeletonBundle') }}
{% endif %}